                  "Price": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "Description": {
                    "type": "string"
                  },
                  "Stock": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "ProductImages": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              },
              "encoding": {
                "CatrgoryId": {
                  "style": "form"
                },
                "Name": {
                  "style": "form"
                },
                "Price": {
                  "style": "form"
                },
                "Description": {
                  "style": "form"
                },
                "Stock": {
                  "style": "form"
                },
                "ProductImages": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
